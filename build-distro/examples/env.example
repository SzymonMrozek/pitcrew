# Copy to build-distro/.env on the server and fill in. Never commit it.

# The public address testers and CI use.
PUBLIC_URL=https://builds.example.com

# Generate with: openssl rand -base64 48
SECRET_KEY_BASE=

# Signs you in at /admin. Use a long random password.
ADMIN_PASSWORD=

# The bucket for builds and the database backup. For R2, the endpoint is
# https://<account-id>.r2.cloudflarestorage.com and the region is auto.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → install command.
CLOUDFLARE_TUNNEL_TOKEN=

# Days before builds' files are deleted. The newest ready build of each
# branch is always kept.
RETENTION_DAYS=30
